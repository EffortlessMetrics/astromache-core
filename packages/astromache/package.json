    "src/Footer.astro",
    "src/Article.astro",
    "src/article-types.ts",
    "src/PostList.astro",
    "src/TaxonomySection.astro",
    "src/ReadingProgress.astro",
    "src/FocusMode.astro",
    "src/CopyLink.astro",
    "src/reading-time.ts",
    "src/publication.css",
    "src/search.css",
    "src/TagList.astro",
    "src/static-offline.mjs",
    "src/static-offline.d.ts",
    "src/PublicationHead.astro",
    "src/publishing",
    "STATIC-PUBLICATION.md"
  ],
  "type": "module",
  "exports": {
    "./document": "./src/Document.astro",
    "./metadata": "./src/metadata.ts",
    "./navigation": "./src/navigation.ts",
    "./fonts.css": "./src/fonts.css",
    "./portfolio": "./src/Portfolio.astro",
    "./publication": "./src/Publication.astro",
    "./header": "./src/Header.astro",
    "./footer": "./src/Footer.astro",
    "./article": "./src/Article.astro",
    "./post-list": "./src/PostList.astro",
    "./taxonomy-section": "./src/TaxonomySection.astro",
    "./reading-progress": "./src/ReadingProgress.astro",
    "./focus-mode": "./src/FocusMode.astro",
    "./copy-link": "./src/CopyLink.astro",
    "./reading-time": "./src/reading-time.ts",
    "./publication.css": "./src/publication.css",
    "./search.css": "./src/search.css",
    "./tag-list": "./src/TagList.astro",
    "./static-offline": {
      "types": "./src/static-offline.d.ts",
      "import": "./src/static-offline.mjs"
