---
import { directoryTitle, type DirectoryProps } from "./directory";

export type Props = DirectoryProps;
const title = directoryTitle(Astro.props.title);
---

<div class="directory-home">
  <h1 class="directory-title">{title}</h1>
  <div class="directory-groups"><slot /></div>
</div>

<style>
  .directory-home {
    min-width: 0;
    margin-block: 1.75rem 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border, currentColor);
  }
  .directory-title {
    margin: 0 0 1.25rem;
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.25rem);
    line-height: 1.3;
    font-weight: 750;
    color: var(--accent, currentColor);
  }
  .directory-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    align-items: start;
    gap: 1.25rem 2rem;
  }
</style>
