---
export interface Props {brand:string;brandHref?:string;links?:ReadonlyArray<{label:string;href:string;current?:boolean}>;navigationLabel?:string;itemsId?:string;overlaySelector?:string;}
const {brand,brandHref='/',links=[],navigationLabel='Primary navigation',itemsId='navigation-items',overlaySelector='[data-tas-dialog]'}=Astro.props;
---
<header class="publication-header" data-overlay-selector={overlaySelector}>
<div class="header-row"><a class="site-title" href={brandHref}>{brand}</a><nav aria-label={navigationLabel}>
<button class="icon-button menu-toggle" type="button" aria-label="Open Menu" aria-expanded="false" aria-controls={itemsId}><slot name="menu-icon"><span class="menu-icon" aria-hidden="true">☰</span></slot><slot name="close-icon"><span class="close-icon" aria-hidden="true">×</span></slot></button>
<div class="nav-items" id={itemsId}>{links.map(link=><a href={link.href} class:list={{'active-nav':link.current}} aria-current={link.current?'page':undefined}>{link.label}</a>)}<slot name="controls"/></div>
</nav></div></header>
<script>
  const header = document.querySelector<HTMLElement>(".publication-header"); const nav = header?.querySelector<HTMLElement>("nav"); const menu = nav?.querySelector<HTMLButtonElement>(".menu-toggle"); const items = document.getElementById(menu?.getAttribute("aria-controls") || "navigation-items");
  const background = [...document.querySelectorAll<HTMLElement>("main, footer")];
  const previousInert = new Map<HTMLElement, boolean>();
  function tabbableControls(container: ParentNode) {
    const candidates = [...container.querySelectorAll<HTMLElement>(
      "a[href],area[href],button,input,select,textarea,iframe,object,embed,summary,[tabindex],[contenteditable]"
    )].filter(element => {
      const editableHost = element.isContentEditable && !element.parentElement?.isContentEditable && !element.hasAttribute("tabindex");
      return (element.tabIndex >= 0 || editableHost) && !element.matches(":disabled") && !element.closest("[inert]") && element.getClientRects().length > 0 && !["hidden", "collapse"].includes(getComputedStyle(element).visibility);
    });
    return candidates.filter(element => {
      if (!(element instanceof HTMLInputElement) || element.type !== "radio" || !element.name) return true;
      const group = candidates.filter(candidate => candidate instanceof HTMLInputElement && candidate.type === "radio" && candidate.name === element.name && candidate.form === element.form) as HTMLInputElement[];
      return element === (group.find(radio => radio.checked) || group[0]);
    }).sort((left, right) => (left.tabIndex > 0 ? left.tabIndex : Number.MAX_SAFE_INTEGER) - (right.tabIndex > 0 ? right.tabIndex : Number.MAX_SAFE_INTEGER));
  }
  function setOpen(open: boolean) {
    menu?.setAttribute("aria-expanded", String(open));
    menu?.setAttribute("aria-label", open ? "Close Menu" : "Open Menu");
    items?.toggleAttribute("data-open", open);
    header?.toggleAttribute("data-menu-open", open);
    for (const element of background) {
      if (open) {
        if (!previousInert.has(element)) previousInert.set(element, element.inert);
        element.inert = true;
      } else if (previousInert.has(element)) {
        element.inert = previousInert.get(element)!;
        previousInert.delete(element);
      }
    }
    if (open) items?.querySelector<HTMLAnchorElement>("a")?.focus();
  }
  menu?.addEventListener("click", () => setOpen(menu.getAttribute("aria-expanded") !== "true"));
  header?.addEventListener("click", event => {
    const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>("a[href]") : null;
    if (!link || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || link.hasAttribute("download") || (link.target && link.target.toLowerCase() !== "_self")) return;
    const target = new URL(link.href);
    if (target.origin === location.origin && target.pathname === location.pathname && target.search === location.search && target.href.includes("#")) setOpen(false);
  });
  document.addEventListener("keydown", event => {
    if (menu?.getAttribute("aria-expanded") !== "true") return;
    const overlays = document.querySelectorAll<HTMLElement>(header?.dataset.overlaySelector || "[data-tas-dialog]");
    if ([...overlays].some(overlay => overlay instanceof HTMLDialogElement ? overlay.open : !overlay.hidden && overlay.getAttribute("aria-hidden") !== "true" && overlay.getClientRects().length > 0 && getComputedStyle(overlay).visibility !== "hidden")) return;
    if (event.key === "Escape" && menu?.getAttribute("aria-expanded") === "true") {
      event.preventDefault();
      setOpen(false);
      menu.focus();
    }
    if (event.key === "Tab" && header) {
      const controls = tabbableControls(header);
      const index = controls.indexOf(document.activeElement as HTMLElement);
      if (index < 0 || (event.shiftKey && index === 0) || (!event.shiftKey && index === controls.length - 1)) {
        event.preventDefault();
        controls[event.shiftKey ? controls.length - 1 : 0]?.focus();
      }
    }
  });
  const desktop = matchMedia("(min-width: 640px)");
  function restoreHeaderFocus(control: HTMLElement) {
    if (control !== menu && !items?.contains(control)) return;
    if (!desktop.matches) menu?.focus();
    else if (control === menu) {
      const target = (items && tabbableControls(items)[0]) || header?.querySelector<HTMLAnchorElement>(".site-title");
      target?.focus();
    } else control.focus();
  }
  // Layout can blur a control before coalesced media-query changes are delivered.
  header?.addEventListener("focusout", event => {
    const control = event.target;
    if (event.relatedTarget !== null || !(control instanceof HTMLElement) || control.getClientRects().length > 0) return;
    requestAnimationFrame(() => {
      if (document.activeElement === document.body) restoreHeaderFocus(control);
    });
  });
  desktop.addEventListener("change", event => {
    const active = document.activeElement;
    if (event.matches) setOpen(false);
    if (active instanceof HTMLElement && active.getClientRects().length === 0) restoreHeaderFocus(active);
  });
</script>


