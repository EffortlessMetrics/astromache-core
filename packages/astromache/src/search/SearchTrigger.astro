---
interface Props {
  id?: string;
  label: string;
  title?: string;
}
const { id = "search-toggle", label, title } = Astro.props;
---
<button class="icon-button" {id} type="button" aria-label={label} {title}>
  <slot>
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="7" />
      <path d="m16 16 5 5" />
    </svg>
  </slot>
</button>
