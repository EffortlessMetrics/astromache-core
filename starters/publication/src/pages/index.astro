---
import Publication from '../layouts/Publication.astro';import TaxonomySection from 'astromache/taxonomy-section';import TagList from 'astromache/tag-list';import {notes,card,tagSlug} from '../publication-content';const entries=await notes();const categories=[...new Set(entries.map(note=>note.data.category))];const tags=[...new Set(entries.flatMap(note=>note.data.tags))];
---
<Publication title="Field Notes" description="Careful observations and practical experiments, collected in an independent publication."><h1>Field Notes</h1><p>Careful observations, practical experiments, and room for a second look.</p>{categories.map(category=><TaxonomySection id={tagSlug(category)+'-notes'} label={category} href={'/tags/'+tagSlug(category)+'/'} itemHeadingLevel={3} items={entries.filter(note=>note.data.category===category).map(card)}/>)}<section><h2>Explore the notebook</h2><TagList items={tags.map(tag=>({label:tag,href:'/tags/'+tagSlug(tag)+'/'}))}/><p><a href="/posts/">All posts</a> / <a href="/portfolio/">Selected work</a> / <a href="/rss.xml">Subscribe with RSS</a></p></section></Publication>
